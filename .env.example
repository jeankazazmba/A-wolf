# A-Wolf — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs manquantes

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Google OAuth 2.0 — Connexion Google Calendar (Electron)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Obtenez votre Client ID depuis :
# https://console.cloud.google.com/apis/credentials
# Type : OAuth 2.0 Client IDs > Desktop App
#
# Copiez la valeur "Client ID" ici :
VITE_GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
