rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    // ID Poisoning Guard
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validation Helpers
    function isValidTask(data) {
      return data.id is string
        && data.title is string
        && data.title.size() <= 256
        && data.completed is bool
        && data.priority is string
        && data.group is string
        && data.star is bool
        && data.subTasks is list
        && data.ownerId == request.auth.uid;
    }

    // Duration and configuration rules for Pomodoro and Long focus
    function isValidFocusSession(data) {
      return data.id is string
        && data.duration is number
        && data.taskRef is string
        && data.type is string
        && (data.type == "Pomodoro" || data.type == "Long" || data.type == "Personnalisé")
        && data.ownerId == request.auth.uid;
    }

    function isValidReminder(data) {
      return data.id is string
        && data.title is string
        && data.title.size() <= 256
        && data.deadline is string
        && data.completed is bool
        && data.active is bool
        && data.ownerId == request.auth.uid;
    }

    function isValidNote(data) {
      return data.id is string
        && data.title is string
        && data.title.size() <= 256
        && data.content is string
        && data.ownerId == request.auth.uid;
    }

    function isValidCalendarEvent(data) {
      return data.id is string
        && data.title is string
        && data.title.size() <= 256
        && data.type is string
        && (data.type == "Cours" || data.type == "Devoirs" || data.type == "Projets" || data.type == "Réunions" || data.type == "Rappels" || data.type == "Autres")
        && data.time is string
        && data.day is number
        && data.subject is string
        && data.color is string
        && data.ownerId == request.auth.uid;
    }

    function isValidResource(data) {
      return data.id is string
        && data.title is string
        && data.title.size() <= 256
        && data.category is string
        && data.type is string
        && (data.type == "pdf" || data.type == "zip" || data.type == "image" || data.type == "doc" || data.type == "other")
        && data.ownerId == request.auth.uid;
    }

    // Collesion rules with Owner-Only Isolation
    match /tasks/{taskId} {
      allow read: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(taskId) && isValidTask(incoming());
      allow update: if isSignedIn() && isValidId(taskId) && isValidTask(incoming()) && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    match /focus_sessions/{sessionId} {
      allow read: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(sessionId) && isValidFocusSession(incoming());
      allow update: if isSignedIn() && isValidId(sessionId) && isValidFocusSession(incoming()) && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    match /reminders/{reminderId} {
      allow read: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(reminderId) && isValidReminder(incoming());
      allow update: if isSignedIn() && isValidId(reminderId) && isValidReminder(incoming()) && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    match /notes/{noteId} {
      allow read: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(noteId) && isValidNote(incoming());
      allow update: if isSignedIn() && isValidId(noteId) && isValidNote(incoming()) && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    match /calendar_events/{eventId} {
      allow read: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(eventId) && isValidCalendarEvent(incoming());
      allow update: if isSignedIn() && isValidId(eventId) && isValidCalendarEvent(incoming()) && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    match /resources/{resourceId} {
      allow read: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(resourceId) && isValidResource(incoming());
      allow update: if isSignedIn() && isValidId(resourceId) && isValidResource(incoming()) && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }
  }
}
